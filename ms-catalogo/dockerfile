# syntax=docker/dockerfile:1.7

FROM maven:3.9-eclipse-temurin-21 AS builder

WORKDIR /build

COPY pom.xml .
COPY .docker-build-deps/tpi-common/1.0-SNAPSHOT /tmp/tpi-common/

RUN --mount=type=cache,id=tpi-backend-maven,target=/root/.m2,sharing=locked \
    mkdir -p /root/.m2/repository/com/tpbackend/tpi-common/1.0-SNAPSHOT && \
    cp -a /tmp/tpi-common/. /root/.m2/repository/com/tpbackend/tpi-common/1.0-SNAPSHOT/ && \
    mvn -B dependency:go-offline

COPY src ./src

RUN --mount=type=cache,id=tpi-backend-maven,target=/root/.m2,sharing=locked \
    mvn -B package -DskipTests



FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

COPY --from=builder /build/target/*.jar app.jar

EXPOSE 8081

ENTRYPOINT ["java", "-jar", "app.jar"]