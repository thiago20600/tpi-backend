#CONEXION KEYCLOAK Y POSTGRESQL
DB_NAME_KC_PG=nombre base de datos
DB_USER_KC_PG=nombre usuario conexion
DB_PASSWORD_KC_PG=password usuario conexion
DB_URL_KC_PG=url de la base de datos de keycloak


#KEYCLOAK
KEYCLOAK_ADMIN=nombre usuario admin
KEYCLOAK_ADMIN_PASSWORD=password usuario admin
KEYCLOAK_ISSUER_URI=uri para autenticacion

#CATALOGO
CATALOGO_DB_URL= url de la base de datos de catalogo
CATALOGO_DB_USER= usuario de la base de datos catalogo
CATALOGO_DB_PASSWORD= password del usuario de la base de datos catalogo
OPENMETEO_BASE_URL=url base de api externa
CATALOGO_DB_NAME=nombre de la base de datos de catalogo

#GRAFANA
GF_SECURITY_ADMIN_USER=nombre usuario admin
GF_SECURITY_ADMIN_PASSWORD=password usuario admin


#SALIDAS Y RESERVAS
SALIDAS_DB_NAME=nombre base de datos
SALIDAS_DB_USER=usuario base de datos
SALIDAS_DB_PASSWORD=password usuario base de datos
SALIDAS_DB_URL=url de la base de datos